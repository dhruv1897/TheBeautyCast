# Copy this file to ".env" and fill in real values.
# The .env file is ignored by git and must never be committed.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# "development" while you build, "production" on the live server.
FLASK_ENV=development

# Leave blank to use the local SQLite file.
# On a real host, paste the Postgres URL they give you.
DATABASE_URL=

# Password for the CSV download at /export/creators?token=...
EXPORT_TOKEN=replace-with-another-random-string
